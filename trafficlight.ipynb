    "import os\n",
    "\n",
    "def check_dataset(images_path, labels_path):\n",
    "    images = set([os.path.splitext(f)[0] for f in os.listdir(images_path)])\n",
    "    labels = set([os.path.splitext(f)[0] for f in os.listdir(labels_path)])\n",
    "\n",
    "    missing_labels = images - labels\n",
    "    missing_images = labels - images\n",
    "\n",
    "    print(f\"Total images: {len(images)}\")\n",
    "    print(f\"Total labels: {len(labels)}\")\n",
    "\n",
    "    if missing_labels:\n",
    "        print(\"\\n❌ Images WITHOUT labels:\")\n",
    "        for f in list(missing_labels)[:10]:\n",
    "            print(f\"  {f}.jpg\")\n",
    "\n",
    "    if missing_images:\n",
    "        print(\"\\n❌ Labels WITHOUT images:\")\n",
    "        for f in list(missing_images)[:10]:\n",
    "            print(f\"  {f}.txt\")\n",
    "\n",
    "    if not missing_labels and not missing_images:\n",
    "        print(\"\\n✅ Perfect! All images and labels match.\")\n",
    "# 👉 Change these paths\n",
    "check_dataset(r\"C:\\Users\\souse\\CDIO3\\dataset\\train\\images\", r\"C:\\Users\\souse\\CDIO3\\dataset\\train\\labels\")\n",
    "\n",
    "check_dataset(r\"C:\\Users\\souse\\CDIO3\\dataset\\valid\\images\", r\"C:\\Users\\souse\\CDIO3\\dataset\\valid\\labels\")"
