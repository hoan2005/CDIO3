    "def detect_traffic_light_color_kmeans(roi, k=4):\n",
    "    if roi is None or roi.size == 0:\n",
    "        return \"UNKNOWN\"\n",
    "\n",
    "    hsv = cv2.cvtColor(roi, cv2.COLOR_BGR2HSV)\n",
    "    pixels = hsv.reshape(-1, 3)\n",
    "\n",
    "    pixels = pixels[(pixels[:, 2] > 100) & (pixels[:, 1] > 60)]\n",
    "    if len(pixels) < 3:\n",
    "        return \"UNKNOWN\"\n",
    "\n",
    "    k = min(k, len(pixels))\n",
    "    if k <= 1:\n",
    "        return \"UNKNOWN\"\n",
    "\n",
    "    kmeans = KMeans(n_clusters=k, n_init=7)\n",
    "    kmeans.fit(pixels)\n",
    "\n",
    "    centers = np.array(kmeans.cluster_centers_)\n",
    "    scores = centers[:, 1] * centers[:, 2]\n",
    "\n",
    "    top2 = centers[np.argsort(scores)[-2:]]\n",
    "\n",
    "    found_red = found_yellow = found_green = False\n",
    "\n",
    "    for h, s, v in top2:\n",
    "        if s < 80 or v < 80:\n",
    "            continue\n",
    "        if (h <= 10) or (h >= 170):\n",
    "            found_red = True\n",
    "        elif 20 <= h <= 35:\n",
    "            found_yellow = True\n",
    "        elif 40 <= h <= 85:\n",
    "            found_green = True\n",
    "\n",
    "    if found_red:\n",
    "        return \"RED\"\n",
    "    if found_yellow:\n",
    "        return \"YELLOW\"\n",
    "    if found_green:\n",
    "        return \"GREEN\"\n",
    "    return \"UNKNOWN\""
   ]
  },
