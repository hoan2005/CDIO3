    "from ultralytics import YOLO\n",
    "import cv2\n",
    "\n",
    "# 1. Khởi tạo mô hình\n",
    "# Nên dùng bản Nano (n) để đạt tốc độ cao nhất khi vẽ bằng OpenCV thời gian thực\n",
    "model = YOLO('yolov8n.pt') \n",
    "\n",
    "# 2. Định nghĩa danh sách các class ID cần lọc (Người + Xe máy)\n",
    "# 0: person, 3: motorcycle\n",
    "target_classes = [0, 3]\n",
    "\n",
    "# 3. Khởi tạo kết nối tới camera (webcam mặc định số 0)\n",
    "video_path = r'D:\\cdio3\\cam1.mp4' \n",
    "cap = cv2.VideoCapture(video_path)\n",
    "\n",
    "# Cấu hình vẽ: Màu sắc cho từng lớp (BGR format)\n",
    "# Người: Xanh lá (0, 255, 0), Xe máy: Đỏ (0, 0, 255)\n",
    "colors = {0: (0, 255, 0), 3: (0, 0, 255)}\n",
    "\n",
    "print(\"Đang chạy... Nhấn 'q' để thoát.\")\n",
    "\n",
    "while cap.isOpened():\n",
    "    # A. Đọc một khung hình từ camera\n",
    "    ret, frame = cap.read()\n",
    "    if not ret:\n",
    "        print(\"Không thể đọc frame từ camera.\")\n",
    "        break\n",
    "    frame = cv2.rotate(frame, cv2.ROTATE_90_CLOCKWISE)\n",
    "    # B. Chạy YOLO detect trên frame này\n",
    "    # Ta dùng verbose=False để console không bị tràn log\n",
    "    results = model.predict(source=frame, classes=target_classes, conf=0.5, verbose=False)\n",
    "\n",
    "    # C. Xử lý kết quả (results[0] chứa dữ liệu của frame hiện tại)\n",
    "    result = results[0]\n",
    "    \n",
    "    # Lấy thông tin về khung (boxes), ID lớp (cls), và độ tin cậy (conf)\n",
    "    if result.boxes is not None:\n",
    "        for i in range(len(result.boxes)):\n",
    "            # Tọa độ khung (x1, y1, x2, y2)\n",
    "            box = result.boxes.xyxy[i].cpu().numpy()\n",
    "            x1, y1, x2, y2 = map(int, box) # Chuyển sang số nguyên để dùng với cv2\n",
    "            \n",
    "            # ID của lớp\n",
    "            cls_id = int(result.boxes.cls[i].item())\n",
    "            \n",
    "            # Độ tin cậy (%)\n",
    "            conf = result.boxes.conf[i].item()\n",
    "\n",
    "            # Tên lớp từ mô hình\n",
    "            class_name = model.names[cls_id]\n",
    "\n",
    "            # D. Tiến hành vẽ lên frame bằng OpenCV\n",
    "\n",
    "            # 1. Lấy màu sắc đã định nghĩa cho lớp này\n",
    "            color = colors.get(cls_id, (255, 255, 255)) # Mặc định trắng nếu không có trong colors\n",
    "\n",
    "            # 2. Vẽ khung chữ nhật (Bounding Box)\n",
    "            cv2.rectangle(frame, (x1, y1), (x2, y2), color, thickness=2)\n",
    "\n",
    "            # 3. Chuẩn bị nội dung chữ (Label + % Confidence)\n",
    "            label_text = f\"{class_name.upper()} {conf:.2f}\"\n",
    "\n",
    "            # 4. Vẽ một ô nền nhỏ phía trên để chữ dễ đọc hơn\n",
    "            # getTextSize để tính toán độ rộng của chữ\n",
    "            (text_width, text_height), _ = cv2.getTextSize(label_text, cv2.FONT_HERSHEY_SIMPLEX, 0.6, 1)\n",
    "            \n",
    "            # Đảm bảo nền không bị vẽ ra ngoài cạnh trên của ảnh\n",
    "            label_y = max(y1, text_height + 10)\n",
    "            \n",
    "            # Vẽ nền chữ\n",
    "            cv2.rectangle(frame, (x1, label_y - text_height - 10), (x1 + text_width, label_y), color, cv2.FILLED)\n",
    "\n",
    "            # 5. Viết chữ lên nền\n",
    "            cv2.putText(frame, label_text, (x1, label_y - 5), \n",
    "                        cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), thickness=1, lineType=cv2.LINE_AA)\n",
    "\n",
    "    # E. Hiển thị khung hình đã được vẽ box\n",
    "    cv2.imshow('YOLO + OpenCV: Nguoi & Xe May', frame)\n",
    "\n",
    "    # F. Thoát nếu nhấn phím 'q'\n",
    "    if cv2.waitKey(1) & 0xFF == ord('q'):\n",
    "        break\n",
    "\n",
    "# G. Giải phóng tài nguyên\n",
    "cap.release()\n",
    "cv2.destroyAllWindows()"
   ]
  }
 ],
